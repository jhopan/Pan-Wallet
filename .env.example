# Infrastructure only. Jangan commit .env yang sudah terisi.

# ------------------------------------------------------------
# Jaringan
# ------------------------------------------------------------
# Host tempat server mendengar.
#   127.0.0.1  = hanya dari mesin ini (AMAN, dipakai bersama cloudflared)
#   0.0.0.0    = terbuka ke jaringan lain (hati-hati, butuh firewall)
PAN_WALLET_HOST=127.0.0.1

# Port internal. Bebas diganti kalau 8080 bentrok.
PAN_WALLET_PORT=8080

# Alamat lengkap (opsional). Kalau diisi, ini MENANG atas HOST+PORT.
# PAN_WALLET_ADDR=127.0.0.1:8080

# URL publik yang dilihat pelanggan (domain cloudflared kamu).
# Dipakai menyusun URL webhook PayPan dan link pembayaran.
PAN_WALLET_PUBLIC_URL=https://wallet.domain-kamu.com

# Reverse proxy yang boleh mengirim header X-Forwarded-For / CF-Connecting-IP.
# WAJIB diisi kalau di belakang tunnel, supaya rate limit memakai IP asli
# pengunjung, bukan IP tunnel. Kosong = header diabaikan (aman, tapi semua
# pengunjung terlihat satu IP sehingga rate limit cepat habis).
PAN_WALLET_TRUSTED_PROXIES=127.0.0.1,::1

# Driver database: sqlite (default, tanpa server) atau postgres (Supabase/managed).
PAN_WALLET_DB_DRIVER=sqlite
PAN_WALLET_DB_PATH=data/pan-wallet.db

# Hanya dipakai bila PAN_WALLET_DB_DRIVER=postgres
# PAN_WALLET_DATABASE_URL=postgres://wallet_user:change-me@db.example.com:5432/postgres?sslmode=require

# Kredensial panel kendali. WAJIB ganti sebelum dipakai.
PAN_WALLET_ADMIN_USER=admin
PAN_WALLET_ADMIN_PASS=change-me-min-8

# ------------------------------------------------------------
# Catatan cloudflared
# ------------------------------------------------------------
# Dengan cloudflared, port TIDAK perlu dibuka ke internet. Cukup:
#
#   cloudflared tunnel --url http://127.0.0.1:8080
#
# atau dengan konfigurasi tetap (~/.cloudflared/config.yml):
#
#   tunnel: <TUNNEL-ID>
#   credentials-file: /path/<TUNNEL-ID>.json
#   ingress:
#     - hostname: wallet.domain-kamu.com
#       service: http://127.0.0.1:8080
#     - service: http_status:404
#
# Lalu jalankan:
#   cloudflared tunnel run <NAMA-TUNNEL>
#
# Jangan lupa isi PAN_WALLET_PUBLIC_URL dan PAN_WALLET_TRUSTED_PROXIES.
