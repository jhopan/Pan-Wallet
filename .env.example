# Infrastructure only. Never commit a populated .env file.
PAN_WALLET_ADDR=:8080

# Supabase pooler or any managed PostgreSQL connection URL.
# Example only. Replace every placeholder locally.
PAN_WALLET_DATABASE_URL=postgres://wallet_user:change-me@db.example.com:5432/postgres?sslmode=require

# Kredensial panel kendali. Ganti sebelum dipakai.
PAN_WALLET_ADMIN_USER=admin
PAN_WALLET_ADMIN_PASS=change-me-min-8
